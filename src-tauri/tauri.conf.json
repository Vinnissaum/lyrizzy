{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lyrizzy",
  "version": "1.3.0",
  "identifier": "com.igreja-trindade.trinity-lyrics",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "operator",
        "title": "Lyrizzy",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: http: https:; media-src 'self' asset: blob: http: https:; frame-src http: https:; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost http://127.0.0.1:8889 https://127.0.0.1:8889"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRENEUxRjk5ODVFNTlBRDMKUldUVG11V0ZtUjlPVFZrSGlrU1BhUkw1RGpxbENiNXg0ZHMyMzFLcE0vSERlNnVJZlphMzVsRXQK",
      "endpoints": [
        "https://github.com/Vinnissaum/lyrizzy/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      },
      "dialog": false
    }
  }
}
